
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "autosize": { "type": "fit-x", "contains": "padding" },
  "config": { "font": "Open Sans", "view": { "stroke": null } },
  "title": {
    "text": "How often genre names appear in English books",
    "subtitle": "1900–2022, mentions per million words printed",
    "color": "#874500",
    "anchor": "middle"
  },
  "data": {
    "url": "data/ngram_genres.json",
    "format": { "type": "json" }
  },
  "transform": [
    { "flatten": ["timeseries"], "as": ["frequency"] },
    {
      "window": [{ "op": "row_number", "as": "row" }],
      "groupby": ["ngram"]
    },
    { "calculate": "1899 + datum.row", "as": "year" },
    { "calculate": "datum.frequency * 1000000", "as": "per_million" }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "scale": { "domain": [1900, 2022], "nice": false },
      "axis": { "format": "d", "tickCount": 12 }
    },
    "y": {
      "field": "per_million",
      "type": "quantitative",
      "title": "Mentions per million words"
    }
  },
  "layer": [
    {
      "params": [
        {
          "name": "pick",
          "select": { "type": "point", "fields": ["ngram"] },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "color": {
          "field": "ngram",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "science fiction", "historical novel", "graphic novel",
              "romance novel", "detective story", "fantasy novel"
            ],
            "range": [
              "#874500", "#4d6275", "#c97b2a",
              "#b5446e", "#7a9a5b", "#9fb0bf"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "columns": 3
          }
        },
        "opacity": {
          "condition": { "param": "pick", "value": 1 },
          "value": 0.15
        },
        "tooltip": [
          { "field": "ngram", "title": "Phrase" },
          { "field": "year", "title": "Year" },
          {
            "field": "per_million",
            "type": "quantitative",
            "title": "Per million words",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 1975,
            "per_million": 1.3,
            "note": "Science fiction booms after 1950"
          },
          {
            "year": 1902,
            "per_million": 0.45,
            "note": "Detective stories peak in the 1930s"
          },
          {
            "year": 2020,
            "per_million": 0.48,
            "note": "Graphic novels take off after 2000"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": { "expr": "datum.year < 1950 ? 'left' : 'right'" },
        "dx": { "expr": "datum.year < 1950 ? 8 : -8" },
        "dy": -6,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#2b1600"
      },
      "encoding": {
        "x": { "field": "year", "type": "quantitative" },
        "y": { "field": "per_million", "type": "quantitative" },
        "text": { "field": "note" }
      }
    }

  ]
}