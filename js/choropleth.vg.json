{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 500,
  "height": 400,
  "view": { "stroke": null },
  "title": {
    "text": "Library loans per person, 2023–24",
    "color": "#874500"
  },
  
  "projection": { "type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0] },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.json",
        "format": { "type": "topojson", "feature": "STE_2021_AUST_GDA2020" }
      },
      "transform": [
        {
          "filter": "datum.properties.STE_NAME21 != 'Other Territories' && datum.properties.STE_NAME21 != 'Outside Australia'"
        },
        {
          "lookup": "properties.STE_NAME21",
          "from": {
            "data": { "url": "data/au_libraries_2023_24.csv" },
            "key": "state",
            "fields": ["abbr", "loans_per_person", "physical_loans_m", "digital_loans_m", "visits_m"]
          }
        }
      ],
      "mark": { "type": "geoshape", "stroke": "white", "strokeWidth": 1 },
      "encoding": {
        "color": {
          "field": "loans_per_person",
          "type": "quantitative",
          "title": "Loans per person",
          "scale": { "scheme": "browns" }
        },
        "tooltip": [
          { "field": "properties.STE_NAME21", "title": "State" },
          { "field": "loans_per_person", "type": "quantitative", "title": "Loans per person" },
          { "field": "physical_loans_m", "type": "quantitative", "title": "Physical loans (millions)" },
          { "field": "digital_loans_m", "type": "quantitative", "title": "Digital loans (millions)" },
          { "field": "visits_m", "type": "quantitative", "title": "Library visits (millions)" }
        ]

        
      }
    },
    {
      "data": {
        "values": [
          { "abbr": "WA",   "lon": 121.5, "lat": -25.5 },
          { "abbr": "NT",   "lon": 133.4, "lat": -19.8 },
          { "abbr": "SA",   "lon": 135.3, "lat": -30.2 },
          { "abbr": "QLD",  "lon": 144.5, "lat": -22.8 },
          { "abbr": "NSW",  "lon": 146.6, "lat": -32.2 },
          { "abbr": "Vic.", "lon": 144.2, "lat": -36.9 },
          { "abbr": "Tas.", "lon": 146.6, "lat": -42.1 },
          { "abbr": "ACT",  "lon": 153.6, "lat": -35.4 }
        ]
      },
      "transform": [
        {
          "lookup": "abbr",
          "from": {
            "data": { "url": "data/au_libraries_2023_24.csv" },
            "key": "abbr",
            "fields": ["loans_per_person"]
          }
        },
        { "calculate": "datum.abbr + ' ' + format(datum.loans_per_person, '.1f')", "as": "label" }
      ],
      "mark": { "type": "text", "fontWeight": "bold", "fontSize": 11 },
      "encoding": {
        "longitude": { "field": "lon", "type": "quantitative" },
        "latitude": { "field": "lat", "type": "quantitative" },
        "text": { "field": "label" },
        "color": {
          "condition": { "test": "datum.loans_per_person > 6.2 && datum.abbr != 'ACT'", "value": "white" },
          "value": "#2b1600"
        }
      }
    }
  ]
}