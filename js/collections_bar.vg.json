{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "config": {
    "font": "'Source Sans 3', sans-serif"
  },
  "title": {
    "text": "Public library collections, 2019–20 to 2023–24"
  },
  "data": {
    "url": "data/au_collections_2019_2024.csv",
    "format": {
      "parse": {
        "physical_items": "number",
        "digital_items": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.physical_items + datum.digital_items",
      "as": "total_items"
    },
    {
      "calculate": "datum.digital_items / datum.total_items",
      "as": "digital_share"
    }
  ],
  "layer": [
    {
      "transform": [
        {
          "fold": [
            "physical_items",
            "digital_items"
          ],
          "as": [
            "format",
            "items"
          ]
        },
        {
          "calculate": "datum.format == 'physical_items' ? 'Physical' : 'Digital (ebooks, audiobooks)'",
          "as": "Format"
        },
        {
          "calculate": "datum.items / 1000000",
          "as": "items_m"
        }
      ],
      "mark": {
        "type": "bar",
        "width": {
          "band": 0.6
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "labelAngle": 0,
            "labelExpr": "replace(datum.value, '-', '–')"
          }
        },
        "y": {
          "field": "items_m",
          "type": "quantitative",
          "title": "Collection items (millions)"
        },
        "color": {
          "field": "Format",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Physical",
              "Digital (ebooks, audiobooks)"
            ],
            "range": [
              "#c9c2b8",
              "#2a9d8f"
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "order": {
          "field": "format",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "Format"
          },
          {
            "field": "items",
            "type": "quantitative",
            "title": "Items",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.total_items / 1000000",
          "as": "total_m"
        },
        {
          "calculate": "format(datum.digital_share, '.0%') + ' digital'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -10,
        "fontSize": 13.6,
        "color": "#2b1600"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "total_m",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}